# =====================================================================
# MẪU cấu hình Supabase cho app Expo — file này ĐƯỢC commit lên Git.
# KHÔNG điền key thật vào đây.
#
# Cách dùng:
#   1. Copy thành file .env cùng thư mục:
#        Copy-Item .env.example .env      (Windows PowerShell)
#        cp .env.example .env             (Git Bash / macOS / Linux)
#   2. Điền giá trị thật vào .env (xin B gửi riêng qua tin nhắn).
#   3. Chạy lại: npx expo start -c        (-c xóa cache, Expo mới đọc .env mới)
#
# Chạy dữ liệu mẫu 5 sản phẩm (demo giao diện): KHÔNG tạo .env,
# hoặc để trống giá trị sau dấu = ở cả 2 biến.
# (Giữ nguyên giá trị YOUR_... sẽ lỗi kết nối.)
# =====================================================================

# URL project Supabase
#   Lấy ở: Project Settings -> Data API -> Project URL
#   CHỈ phần gốc, KHÔNG có /rest/v1/ ở cuối
#   Đúng: https://abcdxyz.supabase.co
#   Sai:  https://abcdxyz.supabase.co/rest/v1/
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Publishable key (bắt đầu bằng sb_publishable_)
#   Lấy ở: Project Settings -> API Keys -> Publishable key
#   Key này nằm trong app nên ai cũng đọc được; dữ liệu được bảo vệ nhờ RLS
#   (database/migrations/04_rls.sql).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# ---------------------------------------------------------------------
# TUYỆT ĐỐI KHÔNG đưa vào frontend (kể cả file .env):
#   - Secret key (sb_secret_...) / service_role key
#   - Mật khẩu database / chuỗi kết nối postgresql://...
#   - API key của LLM (chatbot) -> để ở backend/ (Edge Function)
# Mọi biến EXPO_PUBLIC_* đều bị đóng gói vào app.
# ---------------------------------------------------------------------
